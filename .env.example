# Sao chép thành .env rồi điền. .env chứa mật khẩu proxy, không được commit vào git.

# Thông tin trên trang chi tiết tunnel HE (https://tunnelbroker.net)
# Server IPv4 Address, ví dụ 216.66.80.26
HE_SERVER=
# Routed /64 và Routed /48, phân tách bằng dấu phẩy, ví dụ 2001:db8:1::/64,2001:db8:abcd::/48
HE_PREFIXES=
# IPv4 liên kết cục bộ: để trống với máy chủ cloud dùng NAT 1:1, sau router gia đình có thể điền IP nội bộ
HE_LOCAL=
# Khớp với MTU trên trang Advanced của bảng điều khiển HE
HE_MTU=1480

# Địa chỉ lắng nghe proxy, SOCKS5 và HTTP dùng chung; nên dùng cổng cao ít phổ biến
PROXY_LISTEN=:24601
PROXY_USER=
# Tạo bằng openssl rand -hex 16; không được chứa : @ / và dấu cách
PROXY_PASS=

# Mức log: debug (mỗi yêu cầu một dòng), info (mặc định), warn, error
LOG_LEVEL=info

# Phiên bản image, mặc định latest; có thể ghim thành số phiên bản như 0.3.0
# IMAGE_TAG=latest
